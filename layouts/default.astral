<!DOCTYPE html>
<html>
  <head>
    <title>Xmeyers</title>
    <link rel="icon" href={Astral.url(@site, "/static/img/favicon.ico")} type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href={Astral.asset_path(@site, "styles.css")} />
    <style>
      a { color: blue; text-decoration: none; font-weight: normal; }
      a:hover { text-decoration: underline; }
      ul, ol { list-style-type: none; }
      li { padding-left: 0; margin-left: 0; }
      .cctv-webcam {width: 320px;height: 400px;background-color: #ffffff;}
    </style>
    <script
      :if={Mix.env() == :prod}
      defer
      data-domain="xmeyers"
      src="https://plausible.io/js/script.js"
    >
    </script>
  </head>

  <body>
    <div class="bg-gray-100 md:flex md:items-center md:justify-between">
      <div class="flex-1 min-w-0">
        <div class="py-2 px-4 text-2xl text-gray-900 leading-7 sm:text-3xl sm:truncate">
          <.navlogo site={@site} route={@route} />
          <.navbar site={@site} route={@route} />
        </div>
      </div>
      <div class="flex mt-4 md:mt-0 md:ml-4"></div>
    </div>
    {@content}
  </body>
</html>
